# Copy this file to .env if you need to override anything.
#
# AIRFLOW_UID: the user id the Airflow containers run as. On Linux, set it to
# your own user id so files written by pipeline tasks into the mounted
# repository belong to you instead of a container user:
#
#     echo "AIRFLOW_UID=$(id -u)" > .env
#
# On macOS and Windows, Docker handles file ownership for you and you can
# ignore this file. The default below matches the official Airflow images.
AIRFLOW_UID=50000

# AIRFLOW_FERNET_KEY: encrypts connection credentials Airflow stores in its
# database. The lab stores none, so leaving this unset is fine (Airflow logs
# one warning about it). To set one, generate a key and put it here:
#
#     uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Never commit a real key to git.
